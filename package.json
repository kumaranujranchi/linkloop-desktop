{
  "name": "linkbuild",
  "version": "1.0.0",
  "description": "LinkBuild — SEO Link Exchange Marketplace & Backlink Collaboration Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "build": "npm run build:tailwind && node scripts/build.js",
    "build:tailwind": "npx tailwindcss -i ./css/src/tailwind-input.css -o ./css/tailwind.css --minify",
    "build:tailwind:watch": "npx tailwindcss -i ./css/src/tailwind-input.css -o ./css/tailwind.css --watch",
    "deploy": "CONVEX_DEPLOYMENT=prod:vibrant-marmot-366 convex deploy --typecheck=disable",
    "dashboard": "convex dashboard",
    "seed": "node scripts/seed.js",
    "send-samples": "node scripts/send_sample_emails.js",
    "vercel-build": "node scripts/build.js"
  },
  "dependencies": {
    "convex": "^1.17.0",
    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/nodemailer": "^8.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.4.0"
  }
}
